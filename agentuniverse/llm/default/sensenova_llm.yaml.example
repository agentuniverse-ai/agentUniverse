name: 'default_sensenova_llm'
description: 'default sensenova llm powered by the SenseTime SenseNova SenseChat models'
model_name: 'SenseChat-5'
max_tokens: 1000
temperature: 0.5
streaming: True
api_key: '${SENSENOVA_API_KEY}'
api_base: 'https://api.sensenova.cn/compatible-mode/v1'
proxy: '${SENSENOVA_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.sensenova_llm'
  class: 'SenseNovaLLM'
