name: 'default_gpustack_llm'
description: 'default gpustack llm powered by models deployed on a self-hosted GPUStack gateway'
model_name: 'llama3.1-8b'
max_tokens: 1000
temperature: 0.5
streaming: True
max_context_length: 131072
api_key: '${GPUSTACK_API_KEY}'
api_base: '${GPUSTACK_API_BASE}'
proxy: '${GPUSTACK_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.gpustack_llm'
  class: 'GPUStackLLM'
