name: 'default_hunyuan_llm'
description: 'default hunyuan llm powered by the Tencent Hunyuan models'
model_name: 'hunyuan-turbos-latest'
max_tokens: 1000
temperature: 0.5
streaming: True
api_key: '${HUNYUAN_API_KEY}'
api_base: 'https://api.hunyuan.cloud.tencent.com/v1'
proxy: '${HUNYUAN_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.hunyuan_llm'
  class: 'HunyuanLLM'
