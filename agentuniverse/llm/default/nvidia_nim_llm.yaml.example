name: 'default_nvidia_nim_llm'
description: 'default nvidia nim llm powered by the NVIDIA NIM models'
model_name: 'meta/llama-3.1-405b-instruct'
max_tokens: 1000
temperature: 0.5
streaming: True
api_key: '${NVIDIA_API_KEY}'
api_base: 'https://integrate.api.nvidia.com/v1'
proxy: '${NVIDIA_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.nvidia_nim_llm'
  class: 'NvidiaNimLLM'
