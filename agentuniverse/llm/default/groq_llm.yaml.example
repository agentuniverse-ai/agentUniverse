name: 'default_groq_llm'
description: 'default groq llm powered by the Groq LPU inference service'
model_name: 'openai/gpt-oss-120b'
max_tokens: 1000
temperature: 0.5
streaming: True
api_key: '${GROQ_API_KEY}'
api_base: 'https://api.groq.com/openai/v1'
proxy: '${GROQ_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.groq_llm'
  class: 'GroqLLM'
