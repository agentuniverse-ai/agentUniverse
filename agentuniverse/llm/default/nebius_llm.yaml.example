name: 'default_nebius_llm'
description: 'default nebius llm powered by the Nebius AI Studio open models'
model_name: 'meta-llama/Meta-Llama-3.1-70B-Instruct'
max_tokens: 1000
temperature: 0.5
streaming: True
api_key: '${NEBIUS_API_KEY}'
api_base: 'https://api.studio.nebius.com/v1'
proxy: '${NEBIUS_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.nebius_llm'
  class: 'NebiusLLM'
