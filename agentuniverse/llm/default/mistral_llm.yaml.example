name: mistral_llm
description: Mistral AI LLM component
model_name: mistral-large-latest
api_key: '${MISTRAL_API_KEY}'
api_base: '${MISTRAL_API_BASE}'
proxy: '${MISTRAL_PROXY}'
max_tokens: 4096
temperature: 0.7
streaming: false
metadata:
  type: LLM
  module: agentuniverse.llm.default.mistral_llm
  class: MistralLLM
