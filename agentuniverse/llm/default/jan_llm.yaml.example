name: 'default_jan_llm'
description: 'default jan llm powered by locally served GGUF models'
model_name: 'llama3.1-8b-instruct'
max_tokens: 1000
temperature: 0.5
streaming: True
max_context_length: 131072
api_key: '${JAN_API_KEY}'
api_base: '${JAN_API_BASE}'
proxy: '${JAN_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.jan_llm'
  class: 'JanLLM'
