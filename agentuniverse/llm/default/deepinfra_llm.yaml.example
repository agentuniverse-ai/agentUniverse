name: 'default_deepinfra_llm'
description: 'default deepinfra llm powered by the open-weight models hosted on DeepInfra'
model_name: 'meta-llama/Meta-Llama-3.1-405B-Instruct'
max_tokens: 1000
temperature: 0.5
streaming: True
api_key: '${DEEPINFRA_API_KEY}'
api_base: 'https://api.deepinfra.com/v1/openai'
proxy: '${DEEPINFRA_PROXY}'
metadata:
  type: 'LLM'
  module: 'agentuniverse.llm.default.deepinfra_llm'
  class: 'DeepInfraLLM'
